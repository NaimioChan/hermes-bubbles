{
  "name": "hermes-bubbles",
  "version": "0.1.0",
  "private": true,
  "description": "Bubble-style chat page for the Hermes web dashboard — replaces /chat with a native streaming message stream over the tui_gateway JSON-RPC socket.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "install-plugin": "node build.mjs && node scripts/install-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
